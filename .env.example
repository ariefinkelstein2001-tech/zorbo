ANTHROPIC_API_KEY=tu-key-aqui
PORT=3000

# Klaviyo (opcional — si no está, los hooks de Klaviyo hacen no-op)
KLAVIYO_API_KEY=pk_xxx
KLAVIYO_LIST_FIRST_PURCHASE=xxx
KLAVIYO_LIST_MAYORISTAS=xxx

# Shopify (pendiente de integración)
# SHOPIFY_STORE_DOMAIN=kairos-brewing.myshopify.com
# SHOPIFY_STOREFRONT_TOKEN=xxx
# SHOPIFY_ADMIN_TOKEN=shpat_xxx

# Waitlist mayorista — avisos al equipo (email + WhatsApp) cuando alguien se
# inscribe en "Únete a la waitlist". Si no se configuran, el lead igual queda
# logueado localmente y en Klaviyo, pero NO se envía la notificación.
#  OPCIÓN MÁS SIMPLE — Make / Zapier / n8n: pega aquí la URL del webhook y ese
#  escenario hace el email + WhatsApp. Recibe un JSON con todos los datos del lead.
# WAITLIST_WEBHOOK_URL=https://hook.us1.make.com/xxxxx
#  Destinos (por defecto los del negocio; se pueden sobreescribir):
# WAITLIST_NOTIFY_EMAIL=vfernandez@kairosdrinks.com
# WAITLIST_NOTIFY_WHATSAPP=+56996605516
#  Email vía Resend (https://resend.com):
# RESEND_API_KEY=re_xxx
# RESEND_FROM=Zorbo <noreply@tudominio.cl>     # dominio verificado en Resend
#  WhatsApp vía Twilio (https://twilio.com):
# TWILIO_ACCOUNT_SID=ACxxx
# TWILIO_AUTH_TOKEN=xxx
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886   # tu sender de WhatsApp en Twilio

# ─── Bot "Seba" — DMs de Instagram de Firulais ──────────────────────────────
# Sin META_APP_SECRET y WEBHOOK_VERIFY_TOKEN el webhook rechaza TODO: es lo
# mínimo para que Meta pueda conectarse. Sin IG_ACCESS_TOKEN el bot piensa la
# respuesta pero no la puede mandar.
#   Webhook a registrar en Meta: https://<tu-dominio>/webhooks/instagram
# META_APP_ID=1234567890
# META_APP_SECRET=xxxxxxxx                 # firma X-Hub-Signature-256
# IG_ACCESS_TOKEN=IGQ...                   # token largo (60 días, se renueva solo)
# WEBHOOK_VERIFY_TOKEN=lo-que-invente-arie # el mismo string que se pega en Meta
# IG_GRAPH_VERSION=v23.0                   # opcional
# SEBA_MODEL=claude-sonnet-5               # modelo por defecto (el panel lo pisa)
# SEBA_WEB_URL=https://perrisima.cl        # a dónde manda cuando quieren mirar
# SEBA_CART_DOMAIN=                        # fuerza el dominio del carrito. Normalmente NO hace falta:
#                                          # se configura desde el panel (Bot Seba › Dominio del carrito) y,
#                                          # si se deja vacío, se usa el dominio principal que declara Shopify.
#                                          # OJO: tiene que ser un dominio que apunte a Shopify. zorbo.cl y
#                                          # k-bros.cl son esta misma app: ahí /cart/<variante>:1 da 404.
# SEBA_MAX_HORA=200                        # techo de mensajes automáticos por hora
# SEBA_GAP_MS=1200                         # respiro mínimo entre envíos
# SEBA_DRY_RUN=1                           # piensa y loguea, pero NO manda a Instagram
